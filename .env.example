DISCORD_TOKEN=
CLIENT_ID=
# Opcional: use durante o desenvolvimento para registrar slash commands imediatamente.
GUILD_ID=
DEFAULT_PREFIX=!
# Compatibilidade opcional; slash commands são o modo principal.
ENABLE_PREFIX_COMMANDS=false
# Moderação automática baseada em mensagens; requer Message Content Intent.
ENABLE_AUTOMOD=false
# XP por mensagens; requer Message Content Intent.
ENABLE_LEVELS=false
# Ative somente quando implementar eventos de entrada/saída e boas-vindas.
ENABLE_MEMBER_EVENTS=false
# Opcional na fase inicial; será necessário para economia, níveis e configurações.
MONGO_URI=
# Se true, encerra o bot quando o MongoDB estiver indisponível.
REQUIRE_DATABASE=false
