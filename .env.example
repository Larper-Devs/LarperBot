DISCORD_TOKEN=
GUILD_ID=
DEFAULT_PREFIX=!
ENABLE_PREFIX_COMMANDS=false
ENABLE_AUTOMOD=false
ENABLE_LEVELS=true
ENABLE_MEMBER_EVENTS=true
DATABASE_PATH=./larperbot.sqlite
# O SQLite acima é o cache persistente local e é consultado primeiro.
# O MongoDB é carregado no start e recebe o cache a cada 30 minutos.
MONGO_URI=
MONGO_DATABASE=larperbot
# Cargo aplicado automaticamente quando um membro entra no servidor.
UNVERIFIED_ROLE_ID=918519844020830236
# Render fornece PORT automaticamente; 10000 é o fallback para execução local.
PORT=10000
RUST_LOG=info
